<Page x:Class="RobloxAccountManager.Views.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="40,34"><StackPanel Spacing="28">
        <StackPanel><TextBlock Text="Welcome back" FontSize="32" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/><TextBlock Text="Your local Roblox workspace at a glance." Foreground="{ThemeResource TextSecondaryBrush}" FontSize="15" Margin="0,5,0,0"/></StackPanel>
        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="ACCOUNTS" FontSize="11" CharacterSpacing="90" Foreground="{ThemeResource TextSecondaryBrush}"/><TextBlock Text="{Binding FavoriteCount}" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="FAVORITES" FontSize="11" CharacterSpacing="90" Foreground="{ThemeResource TextSecondaryBrush}"/><TextBlock Text="{Binding FavoriteCount}" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource AccentBrush}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="20"><StackPanel><TextBlock Text="ACTIVE" FontSize="11" CharacterSpacing="90" Foreground="{ThemeResource TextSecondaryBrush}"/><TextBlock Text="{Binding ActiveCount}" FontSize="30" FontWeight="SemiBold" Foreground="#16A06A" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
        <StackPanel Spacing="12"><TextBlock Text="Quick actions" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="Add account" Click="AddAccount_Click"/><Button Content="Launch account" Click="Launch_Click"/><Button Content="Multi launch" Click="MultiLaunch_Click"/></StackPanel></StackPanel>
        <Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="22"><StackPanel Spacing="12"><TextBlock Text="Recent accounts" FontSize="19" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}"/><ListView ItemsSource="{Binding Accounts}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Grid Padding="0,8" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayLabel}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Username}" Foreground="{ThemeResource TextSecondaryBrush}"/></StackPanel><Button Grid.Column="1" Content="Launch" Click="LaunchAccount_Click" Tag="{Binding}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></StackPanel></Border>
    </StackPanel></ScrollViewer>
</Page>
