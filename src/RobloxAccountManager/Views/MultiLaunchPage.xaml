<Page x:Class="RobloxAccountManager.Views.MultiLaunchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer Padding="40,34"><StackPanel Spacing="22"><TextBlock Text="Multi Launch" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Select local accounts and open Roblox through supported public URLs." Foreground="{ThemeResource TextSecondaryBrush}"/><Border Background="{ThemeResource CardBackgroundBrush}" CornerRadius="12" Padding="22"><StackPanel Spacing="14"><TextBlock Text="Selected accounts" FontSize="19" FontWeight="SemiBold"/><ListView ItemsSource="{Binding Accounts}" SelectionMode="Multiple" DisplayMemberPath="DisplayLabel" Height="180"/><NumberBox Header="Delay between launches (seconds)" Value="3" Minimum="0" Maximum="60"/><Button Content="Launch selected" HorizontalAlignment="Left"/></StackPanel></Border><InfoBar IsOpen="True" Severity="Informational" Message="Multi Launch opens standard Roblox links and does not bypass platform authentication or security."/></StackPanel></ScrollViewer></Page>