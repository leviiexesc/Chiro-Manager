<Application
    x:Class="RobloxAccountManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7F8FA" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1C20" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#656A73" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#0D6EFD" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#101215" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1A1D22" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F5F7" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB4BE" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#63A4FF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
